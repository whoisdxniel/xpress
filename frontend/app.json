{
  "expo": {
    "name": "Xpress",
    "slug": "xpress",
    "version": "1.0.16",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xpress.traslados",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Xpress usa tu ubicacion para mostrar el mapa, calcular rutas y actualizar tus viajes en tiempo real."
      }
    },
    "android": {
      "package": "com.xpress.traslados",
      "versionCode": 19,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false,
          "sounds": [
            "./assets/notifications/tienes_servicio.mp3",
            "./assets/notifications/aceptar_servicio.mp3",
            "./assets/notifications/uber_llego.mp3",
            "./assets/notifications/disponibles.mp3"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Xpress usa tu ubicacion para mostrar el mapa, calcular rutas y actualizar tus viajes en tiempo real.",
          "locationAlwaysAndWhenInUsePermission": "Xpress usa tu ubicacion en segundo plano para que tus pasajeros y la operadora vean tu ubicacion en tiempo real durante el servicio.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "@rnmapbox/maps",
      "expo-font"
    ],
    "extra": {}
  }
}
