{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "node scripts/patch-react-native-ios-podspecs.js",
    "android:setup-sdk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\setup-android-sdk.ps1",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build-apk-debug.ps1",
    "android:apk:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build-apk-release.ps1",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^13.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@react-navigation/native": "^6.1.18",
